# ===========================================
# AstraDeFi Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# Copy to .env for production

# ===========================================
# Database (MySQL via Prisma)
# ===========================================
# Local Docker: mysql://root:password@localhost:3306/astra_defi
# Production: Use connection string from PlanetScale/Neon
DATABASE_URL="mysql://root:password@localhost:3306/astra_defi"

# ===========================================
# Redis Cache
# ===========================================
# Local Docker: redis://localhost:6379
# Production: Use Upstash or Railway Redis URL
REDIS_URL="redis://localhost:6379"

# ===========================================
# Blockchain RPC Endpoints (Optional)
# ===========================================
# If not set, public RPCs will be used (rate limited)
# Get free keys at: https://alchemy.com or https://infura.io
ALCHEMY_API_KEY=""
INFURA_API_KEY=""

# ===========================================
# Price Data API
# ===========================================
# CoinGecko API (optional - free tier works without key)
# Get API key at: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=""

# ===========================================
# Wallet Connection
# ===========================================
# Required for WalletConnect v2
# Get project ID at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ===========================================
# Application Settings
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cache TTL (seconds)
PRICE_CACHE_TTL="60"
BALANCE_CACHE_TTL="30"
PORTFOLIO_CACHE_TTL="300"

# ===========================================
# Cron / Background Workers
# ===========================================
# Secret token to authenticate cron route requests
# Used by: /api/cron/prices, /api/cron/snapshots
CRON_SECRET="change-this-in-production"

# ===========================================
# Error Monitoring (Sentry)
# ===========================================
# Get DSN from: https://sentry.io
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ===========================================
# Development Settings
# ===========================================
# Set to "true" to enable debug logging
DEBUG="false"
